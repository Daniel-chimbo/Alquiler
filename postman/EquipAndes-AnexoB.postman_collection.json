    {
      "name": "CP-14 Reporte equipos alquilados del mes",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Orden unidades desc, código asc', () => {",
        "  pm.response.to.have.status(200);",
        "  const r = pm.response.json();",
        "  pm.expect(r.map(x => x.codigo)).to.eql(['EQP-009', 'EQP-003', 'EQP-001', 'EQP-002', 'EQP-005']);",
        "  pm.expect(r.map(x => x.unidadesAlquiladas)).to.eql([8, 6, 4, 2, 2]);",
        "  pm.expect(r.map(x => x.importeBruto)).to.eql([600, 630, 960, 1680, 80]);",
        "});"
