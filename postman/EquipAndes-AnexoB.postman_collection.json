{
  "info": {
    "name": "EquipAndes - Alquileres API (Anexo B)",
    "description": "Casos de prueba CP-01 a CP-16 del examen parcial U1, versión D. Ejecutar en orden sobre una base recién cargada con datos_semilla.sql. Las variables F (hoy + 7), ayer y periodo (AAAA-MM) se calculan solas en el pre-request de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const p = n => String(n).padStart(2, '0');",
          "const fmt = d => d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());",
          "const hoy = new Date();",
          "const f = new Date(hoy); f.setDate(hoy.getDate() + 7);",
          "const ayer = new Date(hoy); ayer.setDate(hoy.getDate() - 1);",
          "pm.collectionVariables.set('F', fmt(f));",
          "pm.collectionVariables.set('ayer', fmt(ayer));",
          "pm.collectionVariables.set('periodo', hoy.getFullYear() + '-' + p(hoy.getMonth() + 1));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "CP-01 Health",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 con database UP', () => {",
        "  pm.response.to.have.status(200);",
        "  const r = pm.response.json();",
        "  pm.expect(r.database).to.eql('UP');",
        "  pm.expect(r).to.have.property('timestamp');",
        "});"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" }
    },
    {
      "name": "CP-02 Categoría duplicada (minúsculas y espacios)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('409 sin insertar', () => pm.response.to.have.status(409));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"   sonido   \",\n  \"descripcion\": \"Duplicada\"\n}" },
        "url": "{{baseUrl}}/api/v1/categorias"
      }
    },
    {
      "name": "CP-03 Equipo inválido",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('400 con los cuatro campos en validationErrors', () => {",
        "  pm.response.to.have.status(400);",
        "  const v = pm.response.json().validationErrors;",
        "  pm.expect(v).to.have.all.keys('codigo', 'nombre', 'tarifaDiaria', 'unidadesDisponibles');",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"eqp1\",\n  \"nombre\": \"TV\",\n  \"tarifaDiaria\": 0,\n  \"unidadesDisponibles\": -1,\n  \"categoriaId\": 1\n}" },
        "url": "{{baseUrl}}/api/v1/equipos"
      }
    },
    {
      "name": "CP-04 Equipo con categoría inexistente",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('404 sin insertar', () => pm.response.to.have.status(404));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"EQP-099\",\n  \"nombre\": \"Equipo de prueba\",\n  \"tarifaDiaria\": 10.00,\n  \"unidadesDisponibles\": 1,\n  \"categoriaId\": 99\n}" },
        "url": "{{baseUrl}}/api/v1/equipos"
      }
    },
    {
      "name": "CP-05 Buscar proyección disponible por tarifa asc",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('EQP-005 y EQP-006 en ese orden; sin EQP-004', () => {",
        "  pm.response.to.have.status(200);",
        "  const r = pm.response.json();",
        "  pm.expect(r.map(e => e.codigo)).to.eql(['EQP-005', 'EQP-006']);",
        "  pm.expect(r[0].tarifaDiaria).to.eql(40);",
        "  pm.expect(r[1].tarifaDiaria).to.eql(110);",
        "});"
      ] } }],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/equipos/buscar?categoriaId=2&disponible=true&orden=tarifa&dir=asc"
      }
    },
    {
      "name": "CP-06 Alquiler CLI-001 (3 días)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('201 con 18 unidades y total 2190.00', () => {",
        "  pm.response.to.have.status(201);",
        "  const r = pm.response.json();",
        "  pm.expect(r.totalUnidades).to.eql(18);",
        "  pm.expect(r.subtotal).to.eql(2190);",
        "  pm.expect(r.descuento).to.eql(0);",
        "  pm.expect(r.montoTotal).to.eql(2190);",
        "  pm.expect(r.detalles.map(d => d.importe)).to.eql([960, 630, 600]);",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"clienteId\": 1,\n  \"fechaInicio\": \"{{F}}\",\n  \"dias\": 3,\n  \"lugarEvento\": \"Centro de convenciones Cerro Juli\",\n  \"detalles\": [\n    { \"equipoId\": 1, \"cantidad\": 4 },\n    { \"equipoId\": 3, \"cantidad\": 6 },\n    { \"equipoId\": 9, \"cantidad\": 8 }\n  ]\n}" },
        "url": "{{baseUrl}}/api/v1/alquileres"
